    {
      "name": "Catalog",
      "item": [
        {
          "name": "Get active membership packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/centers/{{centerId}}/membership-packages",
            "description": "Lấy các gói tập có trạng thái Active của trung tâm. Dữ liệu mẫu dùng centerId = 1."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get published classes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/centers/{{centerId}}/classes",
            "description": "Lấy các lớp có trạng thái Published của trung tâm. Nếu seed chưa có lớp published, API trả mảng rỗng."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Payments - VNPay",
      "description": "Tạo yêu cầu thanh toán cần bearer token của Member.",
      "item": [
        {
          "name": "Create VNPay payment URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"packageId\": {{packageId}},\n  \"bankCode\": \"{{bankCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/payments/create-vnpay-url",
            "description": "Tái sử dụng hóa đơn PendingPayment phù hợp hoặc tạo subscription PendingPayment cùng invoice trong transaction."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Payment URL is returned', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.paymentUrl).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "VNPay callback - missing signature (safe negative test)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/payments/vnpay-callback",
            "description": "Kiểm tra callback từ chối dữ liệu không có chữ ký. Không thay đổi dữ liệu thanh toán. Callback thành công phải dùng query string do VNPay Sandbox ký; không tự tạo chữ ký trong collection để tránh lộ secret."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Callback is rejected without signature', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
